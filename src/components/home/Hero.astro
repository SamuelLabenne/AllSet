---
import { ChevronRight } from '@lucide/astro';
import { url, bookingHref } from '../../config/site';

const sidebar = ['Overview', 'CRM', 'Sales', 'Inventory', 'Accounting', 'Manufacturing', 'Website'];
const kpis = [
  { label: 'Revenue this month', value: '$248,300', delta: '+12.4%' },
  { label: 'Open sales orders', value: '132', delta: '+8' },
  { label: 'Stock on hand', value: '$1.18M', delta: '97% accurate' },
  { label: 'Invoices overdue', value: '4', delta: '−6 this week' },
];
const bars = [38, 46, 42, 55, 51, 63, 58, 70, 66, 78, 74, 88];
const pipeline = [
  { stage: 'New', count: 24, w: 100 },
  { stage: 'Qualified', count: 18, w: 76 },
  { stage: 'Proposal', count: 9, w: 44 },
  { stage: 'Won', count: 6, w: 30 },
];
const activity = [
  { who: 'SO-1042', what: 'Confirmed · Harbour Supply Co.', when: '2m' },
  { who: 'WH/IN/318', what: 'Received · 240 units', when: '14m' },
  { who: 'INV-2291', what: 'Paid · $18,450.00', when: '1h' },
];
---

<section class="hero" data-scroll="page" data-end="0.75">
  <div class="glow" aria-hidden="true"></div>

  <div class="hero-copy container">
    <p class="eyebrow">Odoo implementation · Australia</p>
    <h1 class="display">Your business,<br /><span class="gradient-text">all set.</span></h1>
    <p class="lede">
      We implement Odoo for growing Australian businesses: one connected system for sales, stock,
      finance and operations, set up around the way you actually work.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={bookingHref()}>Book a discovery call</a>
      <a class="link-arrow" href={url('/services/')}>Explore services <ChevronRight /></a>
    </div>
  </div>

  <div class="stage container" aria-hidden="true">
    <div class="window">
      <div class="chrome">
        <span></span><span></span><span></span>
        <div class="address">yourcompany.odoo.com</div>
      </div>
      <div class="app">
        <aside class="side">
          {
            sidebar.map((item, i) => (
              <div class:list={['side-item', { active: i === 0 }]}>
                <i style={`--h:${i * 32}`} />
                {item}
              </div>
            ))
          }
        </aside>
        <div class="main">
          <div class="main-head">
            <div>
              <div class="muted">Wednesday, 4 March</div>
              <div class="greet">Good morning</div>
            </div>
            <div class="pill">All systems in sync</div>
          </div>

          <div class="kpis">
            {
              kpis.map((k) => (
                <div class="panel kpi">
                  <div class="muted">{k.label}</div>
                  <div class="kpi-value">{k.value}</div>
                  <div class="delta">{k.delta}</div>
                </div>
              ))
            }
          </div>

          <div class="lower">
            <div class="panel chart">
              <div class="panel-title">Revenue · last 12 months</div>
              <div class="bars">
                {bars.map((h, i) => <span style={`--h:${h}%;--i:${i}`} />)}
              </div>
            </div>
            <div class="panel pipeline">
              <div class="panel-title">Pipeline</div>
              {
                pipeline.map((p) => (
                  <div class="pipe-row">
                    <span>{p.stage}</span>
                    <b style={`--w:${p.w}%`} />
                    <em>{p.count}</em>
                  </div>
                ))
              }
              <div class="panel-title activity-title">Activity</div>
              {
                activity.map((a) => (
                  <div class="act-row">
                    <strong>{a.who}</strong>
                    <span>{a.what}</span>
                    <em>{a.when}</em>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="window-shadow"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(44px, 6.5vw, 88px));
    padding-bottom: clamp(40px, 8vw, 96px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-copy {
    text-align: center;
    transform: translate3d(0, calc(var(--p) * -60px), 0) scale(calc(1 - var(--p) * 0.04));
    opacity: calc(1 - var(--p) * 0.9);
    animation: rise 1.2s var(--ease) backwards;
  }

  .hero-copy .lede {
    max-width: 700px;
    margin: 24px auto 0;
  }

  .hero-copy .actions {
    margin-top: 32px;
    justify-content: center;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
  }

  /* ── The 3D window: tipped back at rest, flattens as the page scrolls ── */
  .stage {
    margin-top: clamp(44px, 5vw, 72px);
    perspective: 1100px;
    perspective-origin: 50% 0%;
    position: relative;
    animation: rise 1.4s 0.15s var(--ease) backwards;
  }

  .window {
    --tilt: calc((1 - var(--p)) * 30deg);
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin-inline: auto;
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform-origin: 50% 100%;
    transform: rotateX(var(--tilt)) scale(calc(0.9 + var(--p) * 0.1))
      translate3d(0, calc((1 - var(--p)) * -24px), 0);
    will-change: transform;
    font-size: 12px;
    letter-spacing: -0.005em;
    user-select: none;
  }

  .window-shadow {
    position: absolute;
    inset: auto 12% -40px;
    height: 80px;
    background: radial-gradient(closest-side, rgba(60, 60, 140, 0.25), transparent);
    filter: blur(20px);
    opacity: calc(0.4 + var(--p) * 0.6);
  }

  .chrome {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: #fafafc;
  }
  .chrome > span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #e3e3e8;
  }
  .address {
    margin: 0 auto;
    padding: 4px 40px;
    border-radius: 7px;
    background: #efeff3;
    color: var(--faint);
    font-size: 11px;
  }

  .app {
    display: grid;
    grid-template-columns: 170px 1fr;
    min-height: 460px;
  }

  .side {
    padding: 16px 10px;
    border-right: 1px solid var(--line);
    background: #fbfbfd;
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .side-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 9px;
    color: var(--ink-2);
  }
  .side-item i {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: linear-gradient(135deg, hsl(calc(225 + var(--h)) 90% 64%), hsl(calc(255 + var(--h)) 85% 66%));
    opacity: 0.85;
  }
  .side-item.active {
    background: #fff;
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    font-weight: 600;
  }

  .main {
    padding: 20px 22px 22px;
    display: grid;
    gap: 14px;
    align-content: start;
    background: #fff;
  }

  .main-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .greet {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .muted {
    color: var(--faint);
    font-size: 11px;
  }
  .pill {
    padding: 5px 11px;
    border-radius: 999px;
    background: #e9f8f1;
    color: #0e8a5f;
    font-weight: 600;
    font-size: 11px;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    background: #fff;
  }
  .kpi-value {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 4px 0 2px;
  }
  .delta {
    color: #0e8a5f;
    font-size: 11px;
    font-weight: 500;
  }

  .lower {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 12px;
  }
  .panel-title {
    font-weight: 600;
    margin-bottom: 12px;
  }

  .bars {
    height: 190px;
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(180deg, #6a4dff, #2f6bff);
    opacity: calc(0.35 + var(--i) * 0.055);
    transform-origin: bottom;
    transform: scaleY(calc(0.3 + var(--p) * 0.7));
  }

  .pipe-row {
    display: grid;
    grid-template-columns: 64px 1fr 22px;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--ink-2);
  }
  .pipe-row b {
    height: 8px;
    width: var(--w);
    border-radius: 99px;
    background: linear-gradient(90deg, #2f6bff, #b04dff);
  }
  .pipe-row em,
  .act-row em {
    font-style: normal;
    color: var(--faint);
    text-align: right;
  }
  .activity-title {
    margin-top: 16px;
  }
  .act-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    white-space: nowrap;
  }
  .act-row span {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .app {
      grid-template-columns: 1fr;
    }
    .side {
      display: none;
    }
    .kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .window {
      font-size: 10px;
      border-radius: 16px;
    }
    .lower {
      grid-template-columns: 1fr;
    }
    .pipeline {
      display: none;
    }
    .bars {
      height: 120px;
      gap: 5px;
    }
    .kpi-value {
      font-size: 17px;
    }
    .address {
      padding: 3px 16px;
    }
  }
</style>
