---
import { url } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s get you all set.',
  text = 'Tell us about your business and what you’d like Odoo to do. We’ll come back to you to set up a first conversation.',
} = Astro.props;
---

<section class="cta">
  <div class="container narrow center">
    <h2 class="headline reveal">{title}</h2>
    <p class="lede reveal" style="--d:1">{text}</p>
    <div class="actions reveal" style="--d:2">
      <a class="btn btn-light" href={url('/contact/')}>Contact us</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(72px, 9vw, 112px);
    background: var(--grad-deep);
    color: #fff;
  }

  .lede {
    margin: 16px auto 0;
    max-width: 560px;
    color: rgba(255, 255, 255, 0.8);
  }

  .actions {
    justify-content: center;
    margin-top: 32px;
  }
</style>
