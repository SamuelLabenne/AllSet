---
import Logo from './Logo.astro';
import { ChevronRight } from '@lucide/astro';
import { url, bookingHref } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s get you all set.',
  text = 'Tell us where the business is today and where it needs to go. A 30-minute call is usually enough to know whether Odoo, and we, are the right fit.',
} = Astro.props;
---

<section class="cta section" data-scroll="enter" data-start="1" data-end="0.45">
  <div class="container narrow center">
    <div class="mark" aria-hidden="true">
      <Logo id="cta-logo" size={96} />
    </div>
    <h2 class="headline reveal">{title}</h2>
    <p class="lede reveal" style="--d:1">{text}</p>
    <div class="actions reveal" style="--d:2">
      <a class="btn btn-primary" href={bookingHref()}>Book a discovery call</a>
      <a class="link-arrow" href={url('/contact/')}>Send us a message <ChevronRight /></a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--grad-soft);
    overflow: hidden;
    perspective: 900px;
  }

  .mark {
    display: inline-block;
    margin-bottom: 36px;
    transform: rotateY(calc((1 - var(--p)) * -70deg)) rotateX(calc((1 - var(--p)) * 25deg))
      scale(calc(0.7 + var(--p) * 0.3));
    filter: drop-shadow(0 20px 30px rgba(60, 150, 70, calc(0.15 + var(--p) * 0.15)));
  }

  .mark :global(svg) {
    border-radius: 26px;
  }

  .lede {
    margin: 22px auto 0;
    max-width: 620px;
  }

  .actions {
    margin-top: 36px;
  }
</style>
