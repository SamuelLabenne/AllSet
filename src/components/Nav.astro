---
import Brand from './Brand.astro';
import { NAV, url } from '../config/site';

interface Props {
  /** Start transparent with white text (for pages that open on a dark photo). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === url('/') : path.startsWith(url(href)));
---

<header class:list={['nav', { overlay }]} data-nav>
  <div class="nav-inner container">
    <Brand id="nav-logo" />

    <nav aria-label="Main" class="links">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Menu</span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile" aria-label="Mobile" hidden>
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.toggle')!;
  const menu = nav.querySelector<HTMLElement>('#mobile-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 760px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--nav-h);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  /* Over the home photo: transparent with white text until the page scrolls. */
  .overlay:not(.is-scrolled):not(.is-open) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
  }

  .overlay:not(.is-scrolled):not(.is-open) .links a {
    color: rgba(255, 255, 255, 0.85);
  }

  .overlay:not(.is-scrolled):not(.is-open) .links a:hover,
  .overlay:not(.is-scrolled):not(.is-open) .links a[aria-current='page'] {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .overlay:not(.is-scrolled):not(.is-open) .bar {
    background: #fff;
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-inner > :global(.brand) {
    margin-right: auto;
  }

  .links ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink-2);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .links a:hover {
    color: var(--ink);
    background: rgba(15, 27, 45, 0.05);
  }

  .links a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .bar {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.25s, top 0.25s;
  }

  .bar:nth-of-type(2) {
    top: 18px;
  }

  .bar:nth-of-type(3) {
    top: 25px;
  }

  .is-open .bar:nth-of-type(2) {
    top: 21.5px;
    transform: rotate(45deg);
  }

  .is-open .bar:nth-of-type(3) {
    top: 21.5px;
    transform: rotate(-45deg);
  }

  /* No backdrop filter while open, so the fixed menu sizes to the viewport. */
  .is-open {
    background: #fff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .mobile {
    position: fixed;
    inset: var(--nav-h) 0 0;
    height: calc(100dvh - var(--nav-h));
    padding: 20px var(--gutter) 40px;
    background: #fff;
    color: var(--ink);
  }

  .mobile ul {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
  }

  .mobile li a {
    display: block;
    padding: 12px 0;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--line);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 759px) {
    .links {
      display: none;
    }
    .toggle {
      display: block;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
