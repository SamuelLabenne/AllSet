---
import Brand from './Brand.astro';
import PartnerBadge from './PartnerBadge.astro';
import { NAV, SITE, url } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Brand id="footer-logo" size={28} />
        <p>Odoo implementation and support for growing businesses in {SITE.region}.</p>
        <PartnerBadge size="sm" />
      </div>

      <nav aria-label="Footer" class="col">
        <h2>Pages</h2>
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={url(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="col">
        <h2>Contact</h2>
        <ul>
          <li>{SITE.email}</li>
          <li>{SITE.region}</li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <p>
        © {year} {SITE.name}{SITE.abn ? <> · ABN {SITE.abn}</> : <> · ABN to be added</>}
      </p>
      <ul class="legal">
        <li><a href={url('/privacy/')}>Privacy policy</a></li>
        <li><a href={url('/cookies/')}>Cookie policy</a></li>
        <li><button type="button" data-cookie-settings>Cookie settings</button></li>
      </ul>
      <p class="tm">Odoo is a trademark of Odoo S.A.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    padding: 56px 0 28px;
    font-size: 14px;
    color: var(--muted);
  }

  .top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 36px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }

  .about {
    display: grid;
    gap: 16px;
    justify-items: start;
    color: var(--ink);
  }

  .about p {
    max-width: 320px;
    color: var(--muted);
  }

  h2 {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .col a:hover,
  .legal a:hover,
  .legal button:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    padding-top: 20px;
    font-size: 13px;
    color: var(--faint);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .legal a,
  .legal button {
    color: var(--muted);
  }

  .legal button {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    cursor: pointer;
  }

  .tm {
    width: 100%;
  }

  @media (max-width: 720px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
