---
import Logo from './Logo.astro';
import { SITE, url } from '../config/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Odoo implementation', href: url('/services/#implementation') },
      { label: 'Migration & upgrades', href: url('/services/#optimise') },
      { label: 'Support & training', href: url('/services/#support') },
      { label: 'Salesforce & Revenue Cloud', href: url('/services/#salesforce') },
      { label: 'Websites', href: url('/services/#websites') },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About us', href: url('/about/') },
      { label: 'Insights', href: url('/insights/') },
      { label: 'Contact', href: url('/contact/') },
    ],
  },
  {
    title: 'Get in touch',
    links: [
      { label: SITE.email, href: `mailto:${SITE.email}` },
      ...(SITE.linkedin ? [{ label: 'LinkedIn', href: SITE.linkedin }] : []),
      { label: SITE.location, href: url('/contact/') },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={url('/')} class="brand" aria-label={`${SITE.name}, home`}>
          <Logo id="footer-logo" size={28} />
          <span>All Set Consulting</span>
        </a>
        <p>Odoo implementation specialists for Australian businesses.</p>
      </div>

      {
        columns.map((col) => (
          <div class="footer-col">
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer-bottom">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>
        Odoo is a trademark of Odoo S.A. Salesforce and Revenue Cloud are trademarks of
        Salesforce, Inc.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    padding: 64px 0 32px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 17px;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .footer-brand p {
    max-width: 260px;
  }

  h2 {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .brand:hover {
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding-top: 20px;
    font-size: 12px;
    color: var(--faint);
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
