---
// Placeholder brand mark: a tick ("all set") in a blue gradient tile.
interface Props {
  size?: number;
  id?: string;
}
const { size = 28, id = 'logo' } = Astro.props;
const gradId = `${id}-grad`;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1d4ed8"></stop>
      <stop offset="0.55" stop-color="#2f7cf6"></stop>
      <stop offset="1" stop-color="#38bdf8"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill={`url(#${gradId})`}></rect>
  <path
    d="M9.5 16.6l4.4 4.4 8.6-9.6"
    fill="none"
    stroke="#fff"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
