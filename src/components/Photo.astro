---
// Shows src/assets/photos/<name>.(jpg|jpeg|png|webp) if it exists,
// otherwise a labelled placeholder so the layout is ready for the real photo.
import { Image } from 'astro:assets';
import { Camera } from '@lucide/astro';
import { findPhoto } from '../lib/photos';

interface Props {
  name: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  tone?: 'light' | 'dark';
}

const {
  name,
  alt,
  class: className,
  widths = [480, 800, 1200],
  sizes = '(max-width: 800px) 100vw, 50vw',
  loading = 'lazy',
  tone = 'light',
} = Astro.props;

const src = findPhoto(name);
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      class:list={['photo', className]}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={loading}
    />
  ) : (
    <div class:list={['photo', 'placeholder', tone, className]} role="img" aria-label={alt}>
      <span class="label">
        <Camera />
        Photo: {name}.jpg
      </span>
    </div>
  )
}

<style>
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #e6edf8, #f1f5fb);
    color: var(--faint);
  }

  .placeholder.dark {
    place-items: end;
    padding: 20px var(--gutter);
    background: var(--grad-deep);
    color: rgba(255, 255, 255, 0.5);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
  }

  .label :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
