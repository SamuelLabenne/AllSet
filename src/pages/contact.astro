---
import { Check } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { SITE, url } from '../config/site';

const { endpoint, turnstileSiteKey } = SITE.form;

---

<Base
  title="Contact"
  description="Contact All Set Partners, official Odoo partner, about implementing or improving Odoo in your business."
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Let’s get you all set.</h1>
      <p class="lede">
        Tell us about your business and what you’d like Odoo to do. We’ll come back to you to set up
        a first conversation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      {
        endpoint && (
          <div class="form-card reveal">
            <form id="contact-form" class="form" data-endpoint={endpoint} novalidate>
              <div class="row">
                <div class="field">
                  <label for="name">Name</label>
                  <input class="input" id="name" name="name" autocomplete="name" maxlength="100" required />
                </div>
                <div class="field">
                  <label for="email">Email</label>
                  <input class="input" id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
                </div>
              </div>
              <div class="field">
                <label for="company">
                  Company <span class="hint">(optional)</span>
                </label>
                <input class="input" id="company" name="company" autocomplete="organization" maxlength="150" />
              </div>
              <div class="field">
                <label for="message">Message</label>
                <textarea
                  class="input"
                  id="message"
                  name="message"
                  minlength="10"
                  maxlength="5000"
                  required
                  placeholder="A little about your business, the tools you use today, and what you’d like Odoo to do."
                />
              </div>

              <div class="trap" aria-hidden="true">
                <label for="website">Leave this empty</label>
                <input id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              {turnstileSiteKey && (
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-size="flexible" />
              )}

              <div class="submit-row">
                <button class="btn btn-primary" type="submit">Send message</button>
                <p class="privacy">
                  We only use your details to reply to you. See our{' '}
                  <a href={url('/privacy/')}>privacy policy</a>.
                </p>
              </div>
              <p class="status" role="status" aria-live="polite" />
            </form>

            <div class="success" hidden>
              <span class="success-icon">
                <Check />
              </span>
              <h2 class="title">Thanks, your message is on its way.</h2>
              <p>We’ll get back to you soon to set up a first conversation.</p>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

{
  turnstileSiteKey && endpoint && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const success = form.parentElement!.querySelector<HTMLElement>('.success')!;
    const w = window as Window & { turnstile?: { reset: () => void } };

    const showError = (message: string) => {
      status.textContent = message;
      status.classList.add('is-error');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');
      form.classList.add('was-validated');

      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')].find(
        (el) => !el.checkValidity(),
      );
      if (invalid) {
        invalid.focus();
        if (invalid.id === 'email' && invalid.value) showError('Please enter a valid email address.');
        else if (invalid.id === 'message' && invalid.value)
          showError('Please write a little more (at least 10 characters).');
        else showError('Please fill in your name, email and message.');
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: new FormData(form) });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');
        form.hidden = true;
        success.hidden = false;
      } catch (err) {
        showError(`${(err as Error).message} Please try again in a moment.`);
        w.turnstile?.reset();
      } finally {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  }
</script>

<style>
  /* ── Form ── */
  .form-card {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .form {
    display: grid;
    gap: 20px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }

  .hint {
    font-weight: 400;
    color: var(--faint);
  }

  .input {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  textarea.input {
    min-height: 160px;
    resize: vertical;
    line-height: 1.5;
  }

  .input::placeholder {
    color: var(--faint);
  }

  .input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(29, 78, 216, 0.14);
  }

  .was-validated .input:invalid {
    border-color: #c62828;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .submit-row .btn:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .privacy {
    max-width: 300px;
    font-size: 13px;
    color: var(--faint);
  }

  .privacy a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .status {
    font-size: 15px;
    color: var(--ink-2);
  }

  .status:empty {
    display: none;
  }

  .status.is-error {
    color: #c62828;
  }

  .success {
    padding: 32px 8px;
    text-align: center;
  }

  .success-icon {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
  }

  .success-icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .success p {
    margin-top: 10px;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
