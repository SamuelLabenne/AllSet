---
import { Mail, MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';

const include = [
  'A little about your business and your team',
  'The tools or systems you use today',
  'What you’d like Odoo to do for you',
  'Your timeline, if you have one in mind',
];

const steps = [
  'We reply to set up a first conversation.',
  'We talk through how your business works and what you need.',
  'You get a clear proposal with scope, timeline and price.',
];
---

<Base
  title="Contact"
  description="Contact All Set Partners, official Odoo partner, about implementing or improving Odoo in your business."
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Let’s get you all set.</h1>
      <p class="lede">
        Tell us about your business and what you’d like Odoo to do. We’ll come back to you to set up
        a first conversation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="details reveal">
        <div class="detail">
          <span class="icon"><Mail /></span>
          <div>
            <p class="label">Email</p>
            <!-- Plain text until the mailbox is set up; turn into a mailto: link then. -->
            <p class="value">{SITE.email}</p>
          </div>
        </div>
        <div class="detail">
          <span class="icon"><MapPin /></span>
          <div>
            <p class="label">Where we work</p>
            <p class="value">{SITE.region}</p>
          </div>
        </div>
      </div>

      <div class="info">
        <div class="reveal" style="--d:1">
          <h2 class="title">Helpful to include</h2>
          <ul class="bullets">
            {include.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="reveal" style="--d:2">
          <h2 class="title">What happens next</h2>
          <ol class="next">
            {steps.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .details {
    display: grid;
    gap: 24px;
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--radius);
    background: var(--grad-soft);
    border: 1px solid var(--line);
  }

  .detail {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--grad);
    color: #fff;
  }

  .icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .label {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .value {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 600;
    letter-spacing: -0.015em;
    word-break: break-word;
  }

  .info {
    display: grid;
    gap: 40px;
  }

  .info .title {
    margin-bottom: 14px;
  }

  .bullets {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
    color: var(--ink-2);
  }

  .bullets li::marker {
    color: var(--accent);
  }

  .next {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .next li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    color: var(--ink-2);
  }

  .next li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
