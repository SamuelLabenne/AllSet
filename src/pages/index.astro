---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PartnerBadge from '../components/PartnerBadge.astro';
import CTA from '../components/CTA.astro';
import { SITE, url } from '../config/site';
import { team } from '../data/team';

const services = [
  {
    title: 'Implementation',
    text: 'A complete Odoo implementation: scoping, configuration, data migration and training, delivered in clear phases with an agreed scope and price.',
  },
  {
    title: 'Migration & upgrades',
    text: 'Moving from spreadsheets, an accounting package or another ERP, or upgrading an older Odoo version. We move your data across and tidy up along the way.',
  },
  {
    title: 'Customisation & integrations',
    text: 'Custom modules where standard Odoo falls short, and connections to your webshop, payment providers, banks and other tools.',
  },
  {
    title: 'Support & training',
    text: 'Ongoing support from the people who set it up, and training for users and administrators as your business grows.',
  },
];

const steps = [
  { title: 'Discover', text: 'We learn how your business runs today and what you need from Odoo.' },
  { title: 'Plan', text: 'You get a clear proposal with scope, timeline and price before anything is built.' },
  { title: 'Build', text: 'We configure Odoo, migrate your data and show you progress along the way.' },
  { title: 'Go live', text: 'Training, a planned go-live, and support from us afterwards.' },
];
---

<Base navOverlay>
  <section class="hero">
    <div class="hero-bg">
      <Photo
        name="hero"
        alt=""
        tone="dark"
        loading="eager"
        widths={[800, 1400, 2000]}
        sizes="100vw"
      />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <PartnerBadge tone="dark" />
      <h1 class="display">Get your business all set with Odoo.</h1>
      <p class="lede">
        {SITE.name} is an official Odoo partner. We implement Odoo for growing businesses in
        Australia and Europe, and support it long after go-live.
      </p>
      <div class="actions">
        <a class="btn btn-light" href={url('/contact/')}>Contact us</a>
        <a class="btn btn-outline-light" href={url('/about/')}>About us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <div class="reveal">
        <p class="eyebrow">Odoo partner</p>
        <h2 class="headline">Focused entirely on Odoo.</h2>
      </div>
      <div class="intro-text">
        <p class="reveal" style="--d:1">
          Odoo brings sales, inventory, invoicing, accounting and much more onto one platform. We
          help you choose the apps you need, set them up around the way you work, and make sure
          your team is confident using them.
        </p>
        <p class="reveal" style="--d:2">
          Because Odoo is all we do, you work with people who know the platform well and give
          honest advice about what to configure, what to build and what to leave out.
        </p>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">What we do</p>
        <h2 class="headline reveal" style="--d:1">Odoo, from first workshop to long after go-live.</h2>
      </div>
      <div class="services">
        {
          services.map((s, i) => (
            <article class="service reveal" style={`--d:${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="title">{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">How we work</p>
        <h2 class="headline reveal" style="--d:1">Four clear steps.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <span class="step-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="team-head">
        <div class="section-head">
          <p class="eyebrow reveal">Who we are</p>
          <h2 class="headline reveal" style="--d:1">The people behind {SITE.name}.</h2>
          <p class="lede reveal" style="--d:2">
            We’re Samuel and Freek, the founders of {SITE.name}. When you work with us, you work
            directly with the two of us.
          </p>
        </div>
        <a class="link reveal" href={url('/about/')}>Meet the team →</a>
      </div>
      <div class="team">
        {
          team.map((m, i) => (
            <a class="member reveal" style={`--d:${i}`} href={url('/about/')}>
              <div class="photo-frame">
                <Photo
                  name={m.photo}
                  alt={`Portrait of ${m.name}`}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 760px) 100vw, 45vw"
                />
              </div>
              <div class="member-body">
                <h3>{m.name}</h3>
                <p>{m.role}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: max(600px, 88vh);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 31, 68, 0.55) 0%, rgba(11, 31, 68, 0.15) 35%, rgba(11, 31, 68, 0.75) 100%),
      linear-gradient(90deg, rgba(11, 31, 68, 0.6) 0%, rgba(11, 31, 68, 0) 70%);
  }

  .hero-content {
    position: relative;
    padding-top: calc(var(--nav-h) + 48px);
    padding-bottom: clamp(56px, 9vw, 112px);
  }

  .hero-content .display {
    max-width: 820px;
    margin-top: 28px;
  }

  .hero-content .lede {
    max-width: 600px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-content .actions {
    margin-top: 32px;
  }

  /* ── Intro ── */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }

  .intro-text {
    display: grid;
    gap: 18px;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--ink-2);
  }

  /* ── Services ── */
  .services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .service {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .num {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 700;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .service .title {
    margin-bottom: 10px;
  }

  .service p {
    color: var(--muted);
  }

  /* ── Steps ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps li {
    position: relative;
    padding-top: 4px;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-weight: 700;
  }

  .steps h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .steps p {
    color: var(--muted);
  }

  /* ── Team photos ── */
  .team-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .team-head .link {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .team {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 920px;
  }

  .member {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    transition: box-shadow 0.2s;
  }

  .member:hover {
    box-shadow: var(--shadow);
  }

  .photo-frame {
    aspect-ratio: 4 / 4.2;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .member-body {
    padding: 20px 24px 24px;
  }

  .member-body h3 {
    font-size: 22px;
  }

  .member-body p {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .intro,
    .services {
      grid-template-columns: 1fr;
    }
    .team {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
