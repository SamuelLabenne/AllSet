---
import { MessageSquare, Layers, Target, HeartHandshake } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

// TODO: add portraits and LinkedIn URLs.
const team = [
  {
    name: 'Samuel Labenne',
    initials: 'SL',
    role: 'Co-founder · Technical lead',
    bio: [
      'A developer at heart, Samuel leads the technical side of every project: solution architecture, configuration, data migration and integrations.',
      'When standard Odoo can’t do the job, Samuel builds what’s missing, cleanly and upgrade-safe, and only when it genuinely earns its place.',
    ],
    colors: ['#74e3a4', '#c9ec70'],
    linkedin: '',
  },
  {
    name: 'Freek van Reijen',
    initials: 'FvR',
    role: 'Co-founder · Commercial lead',
    bio: [
      'Freek comes from SAP sales, so knows the ERP world from the commercial side: what it takes to build a sound business case and keep a project tied to real outcomes.',
      'At All Set, Freek leads client relationships, scoping and proposals, making sure every engagement is clearly defined and set up to pay for itself.',
    ],
    colors: ['#b8ea6c', '#f3dc62'],
    linkedin: '',
  },
];

const values = [
  {
    Icon: MessageSquare,
    title: 'Honest advice',
    text: 'If Odoo isn’t the right fit, or a feature isn’t worth building, we’ll tell you, even when it costs us work.',
  },
  {
    Icon: Layers,
    title: 'Standard first',
    text: 'We lean on what Odoo does well out of the box and customise only where it clearly earns its keep.',
  },
  {
    Icon: Target,
    title: 'Own the outcome',
    text: 'We measure success by how your team works six months after go-live, not by hours billed.',
  },
  {
    Icon: HeartHandshake,
    title: 'Stay close',
    text: 'Small by design, so you always deal with the people who know your business and your system.',
  },
];
---

<Base
  title="About us"
  description="All Set Consulting is a small, senior Odoo consultancy helping growing businesses in Australia and Europe implement Odoo properly and keep improving it."
>
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container narrow">
      <p class="eyebrow reveal">About us</p>
      <h1 class="display reveal" style="--d:1">Small team.<br />High standards.</h1>
      <p class="lede reveal" style="--d:2">
        All Set Consulting was founded to bring a better kind of ERP implementation to growing
        businesses in Australia and Europe: senior, straightforward, and in it for the long run.
      </p>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story">
      <h2 class="headline reveal">Why we started All Set.</h2>
      <div class="story-text">
        <p class="reveal">
          We’ve seen what happens when business software is implemented well: teams stop
          re-keying data, month-end stops being a scramble, and owners finally see the whole
          business in one place.
        </p>
        <p class="reveal" style="--d:1">
          We’ve also seen the other side: projects handed to junior teams, scopes that never quite
          close, and systems that are customised until nobody dares upgrade them.
        </p>
        <p class="reveal" style="--d:2">
          Between the two of us we cover both sides of an ERP project. Freek brings a commercial
          background in SAP sales; Samuel brings a developer’s grasp of how these systems are built
          and connected. Together, that means sound business advice and solid engineering from the
          same small team.
        </p>
        <p class="reveal" style="--d:3">
          All Set exists to do it the first way, every time. We focus on Odoo because it gives
          growing businesses an enterprise-grade platform without enterprise-grade complexity. And
          we stay small so that the people you trust at the start are the people who see it
          through.
        </p>
      </div>
    </div>
  </section>

  <section class="section soft name-section" data-scroll="enter" data-start="0.95" data-end="0.35">
    <div class="container narrow center">
      <div class="tick" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="54" pathLength="100"></circle>
          <path d="M38 62l15 15 30-33" pathLength="100"></path>
        </svg>
      </div>
      <p class="eyebrow reveal">Why “All Set”?</p>
      <h2 class="headline reveal" style="--d:1">
        Because that’s how go-live should feel.
      </h2>
      <p class="lede reveal" style="--d:2">
        Everything in its place, everyone trained, nothing left hanging. That feeling is what we
        design every project around.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow reveal">The team</p>
        <h2 class="headline reveal" style="--d:1">The people you’ll work with.</h2>
        <p class="lede reveal" style="--d:2">
          One commercial lead, one technical lead, and no hand-offs in between.
        </p>
      </div>

      <div class="team">
        {
          team.map((m, i) => (
            <div class="member-wrap reveal" style={`--d:${i}`}>
              <article class="member" data-tilt="5" style={`--c1:${m.colors[0]};--c2:${m.colors[1]}`}>
                <div class="portrait" aria-hidden="true">
                  <span class="layer l1" />
                  <span class="layer l2" />
                  <span class="initials">{m.initials}</span>
                  <span class="photo-note">Photo coming soon</span>
                </div>
                <div class="member-body">
                  <h3>{m.name}</h3>
                  <p class="role">{m.role}</p>
                  {m.bio.map((line) => (
                    <p class="bio">{line}</p>
                  ))}
                  {m.linkedin && (
                    <a class="link-arrow" href={m.linkedin} rel="noopener" target="_blank">
                      LinkedIn
                    </a>
                  )}
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow reveal">How we work</p>
        <h2 class="headline reveal" style="--d:1">What you can count on.</h2>
      </div>
      <div class="grid values">
        {
          values.map(({ Icon, title, text }, i) => (
            <div class="card reveal" style={`--d:${i}`}>
              <span class="icon-chip">
                <Icon />
              </span>
              <h3 class="value-title">{title}</h3>
              <p class="muted-text">{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA title="Let’s talk about your business." />
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .story .headline {
    position: sticky;
    top: calc(var(--nav-h) + 48px);
  }

  .story-text {
    display: grid;
    gap: 24px;
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: -0.016em;
  }

  @media (max-width: 820px) {
    .story {
      grid-template-columns: 1fr;
    }
    .story .headline {
      position: static;
    }
  }

  /* The tick draws itself as the section scrolls in. */
  .tick {
    width: 104px;
    margin: 0 auto 32px;
    perspective: 600px;
  }

  .tick svg {
    transform: rotateY(calc((1 - var(--p)) * 60deg));
  }

  .tick circle,
  .tick path {
    fill: none;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tick circle {
    stroke: #d5efd9;
    stroke-dasharray: calc(var(--p) * 100) 100;
  }

  .tick path {
    stroke: var(--accent);
    stroke-dasharray: calc(clamp(0, var(--p) * 1.6 - 0.5, 1) * 100) 100;
  }

  .name-section .lede {
    margin: 20px auto 0;
    max-width: 620px;
  }

  /* ── Team ── */
  .team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 32px);
    max-width: 980px;
    margin-inline: auto;
  }

  .member {
    height: 100%;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 3.4;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--c1) 14%, #fff),
      color-mix(in srgb, var(--c2) 22%, #fff)
    );
    transform-style: preserve-3d;
  }

  .layer {
    position: absolute;
    border-radius: 50%;
    transition: transform 0.8s var(--ease);
  }

  .l1 {
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 35% 30%, #fff, var(--c1) 75%);
    opacity: 0.8;
    transform: translate3d(calc(var(--mx, 0) * 28px), calc(var(--my, 0) * 28px), 0);
  }

  .l2 {
    width: 36%;
    aspect-ratio: 1;
    right: 8%;
    top: 10%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--c2) 75%);
    opacity: 0.8;
    transform: translate3d(calc(var(--mx, 0) * -44px), calc(var(--my, 0) * -44px), 0);
  }

  .initials {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 104px);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgba(18, 44, 28, 0.82);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .photo-note {
    position: absolute;
    bottom: 14px;
    right: 16px;
    font-size: 12px;
    color: rgba(18, 44, 28, 0.55);
  }

  .member-body {
    padding: clamp(24px, 3vw, 36px);
  }

  .member h3 {
    font-size: 26px;
    font-weight: 650;
    letter-spacing: -0.022em;
  }

  .role {
    margin-top: 4px;
    color: var(--accent);
    font-weight: 500;
  }

  .bio {
    margin-top: 14px;
    color: var(--muted);
  }

  .role + .bio {
    margin-top: 18px;
  }

  @media (max-width: 700px) {
    .team {
      grid-template-columns: 1fr;
    }
  }

  /* ── Values ── */
  .values {
    grid-template-columns: repeat(4, 1fr);
  }

  .value-title {
    font-size: 21px;
    margin-bottom: 10px;
  }

  .muted-text {
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .values {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
