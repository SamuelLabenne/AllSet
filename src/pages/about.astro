---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PartnerBadge from '../components/PartnerBadge.astro';
import CTA from '../components/CTA.astro';
import Email from '../components/Email.astro';
import { SITE } from '../config/site';
import { team } from '../data/team';

const values = [
  {
    title: 'Odoo only',
    text: 'Odoo is the only platform we work with, so our advice and our work are focused.',
  },
  {
    title: 'Direct',
    text: 'You work with the founders, from the first conversation to go-live.',
  },
  {
    title: 'Clear scope and price',
    text: 'Every phase is agreed before it starts, so there are no surprises.',
  },
  {
    title: 'Here after go-live',
    text: 'We stay around for support, training and improvements.',
  },
];
---

<Base
  title="About"
  description="All Set Partners is an Odoo consultancy and official Odoo partner, founded by Sam and Freek: two friends from Brussels, now based in Perth and Madrid."
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1 class="display">About {SITE.name}</h1>
      <p class="lede">
        An Odoo consultancy and official Odoo partner, working with growing businesses in Australia
        and Europe.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container story">
      <div class="story-photo reveal">
        <Photo
          name="about"
          alt="Sam and Freek, friends since high school"
          widths={[500, 800, 1100]}
          sizes="(max-width: 860px) 100vw, 45vw"
        />
      </div>
      <div class="story-text">
        <h2 class="headline reveal">Our story</h2>
        <p class="reveal" style="--d:1">
          We’re Sam and Freek, and we’ve been friends since high school in Brussels. So it feels
          fitting that we work with Odoo: like us, it got its start in Belgium.
        </p>
        <p class="reveal" style="--d:2">
          Life later took us to opposite sides of the world, to Perth and Madrid.
          That’s why {SITE.name} works with businesses in both Australia and Europe,
          with one of us close by in each.
        </p>
        <p class="reveal" style="--d:3">
          We started {SITE.name} to make Odoo implementations straightforward: experienced people, a
          clear scope and price, and support that doesn’t stop at go-live. Odoo is the only thing we
          do, so our advice about what to configure, what to build and what to leave out is focused
          and honest.
        </p>
        <p class="reveal" style="--d:4">
          Why the name? Because that’s how go-live should feel: everything in place, everyone
          trained, nothing left hanging. All set.
        </p>
        <div class="reveal" style="--d:5"><PartnerBadge /></div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">The team</p>
        <h2 class="headline reveal" style="--d:1">The founders.</h2>
      </div>
      <div class="founders">
        {
          team.map((f, i) => (
            <article class="founder reveal" style={`--d:${i}`}>
              <div class="portrait">
                <Photo
                  name={f.photo}
                  alt={`Portrait of ${f.name}`}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 760px) 100vw, 45vw"
                />
              </div>
              <div class="founder-body">
                <h3>{f.name}</h3>
                <p class="role">{f.role}</p>
                <p class="bio">{f.bio}</p>
                <Email address={f.email} class="founder-email" />
                {f.linkedin && (
                  <a class="link" href={f.linkedin} target="_blank" rel="noopener">
                    LinkedIn →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">How we work</p>
        <h2 class="headline reveal" style="--d:1">What you can expect.</h2>
      </div>
      <div class="values">
        {
          values.map((v, i) => (
            <div class="value reveal" style={`--d:${i}`}>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .story-photo {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .story-text {
    display: grid;
    gap: 18px;
    justify-items: start;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--ink-2);
  }

  .founders {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 920px;
  }

  .founder {
    overflow: hidden;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .portrait {
    aspect-ratio: 4 / 4.4;
    overflow: hidden;
  }

  .founder-body {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: clamp(22px, 3vw, 32px);
  }

  .founder h3 {
    font-size: 24px;
  }

  .role {
    margin-top: -4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  .bio {
    color: var(--muted);
  }

  .founder-body :global(.founder-email) {
    font-weight: 600;
    color: var(--ink);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .value {
    padding-top: 20px;
    border-top: 2px solid transparent;
    border-image: var(--grad) 1;
  }

  .value h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .value p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .values {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .story,
    .founders {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
