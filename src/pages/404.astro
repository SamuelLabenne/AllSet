---
import Base from '../layouts/Base.astro';
import { url } from '../config/site';
---

<Base title="Page not found">
  <section class="page-header not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="display">Page not found.</h1>
      <p class="lede">The page you’re looking for has moved or doesn’t exist.</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/')}>Back to home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: 70vh;
  }

  .actions {
    margin-top: 28px;
  }
</style>
